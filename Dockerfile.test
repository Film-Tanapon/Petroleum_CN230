FROM python:3.12-slim
WORKDIR /suite
RUN pip install --no-cache-dir pytest==8.3.5 mysql-connector-python==9.2.0 python-dotenv openpyxl
COPY conftest.py pytest.ini ./
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY ["CN230 Petrolium Data/", "CN230 Petrolium Data/"]
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider"]
